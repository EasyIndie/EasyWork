# ── EasyWork 配置示例（v2）────────────────────────────────
# EasyWork 的配置文件位于 ~/.easywork/config.toml
# 用命令管理：
#   easywork config                查看当前配置
#   easywork config get <键>       读取
#   easywork config set <键> <值>  写入
#   easywork config edit           编辑
#
# 旧版 ~/.easywork/config（ini）会在首次 install / config edit 时自动迁移。

schema_version = 1

[shell]
enable_aliases      = true    # 安全别名（默认开）
enable_fancy_prompt = false   # 花哨提示符（含 Git 分支），默认关
enable_ohmyzsh      = false   # Oh My Zsh，默认关
enable_net_tools    = false   # macOS 网络/VPN 工具函数，默认关

[git]
identity = "personal"         # personal | work | custom
scope    = "global"           # global | local

[git.identities.personal]
name  = ""
email = ""

[git.identities.work]
name  = ""
email = ""

[vim]
enabled = true
